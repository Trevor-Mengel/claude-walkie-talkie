{
  "name": "collabcast",
  "version": "0.3.0",
  "description": "Asynchronous two-way messaging between concurrent coding-agent sessions and the human operator.",
  "type": "module",
  "license": "MIT",
  "author": "Trevor Mengel <trevor@cloutdesk.com>",
  "homepage": "https://github.com/Trevor-Mengel/collabcast",
  "bugs": "https://github.com/Trevor-Mengel/collabcast/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trevor-Mengel/collabcast.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "collabcast",
    "mcp",
    "mcp-server",
    "messaging",
    "multi-agent",
    "productivity",
    "project-management",
    "workflow"
  ],
  "bin": {
    "collabcast": "bin/collabcast.js",
    "collabcast-mcp": "bin/collabcast-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "hooks",
    "commands",
    "omp-extension",
    "plugin.json",
    ".mcp.json",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern src test bin",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"bin/**/*.js\"",
    "start:mcp": "node ./bin/collabcast-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "express": "^4.19.0",
    "node-notifier": "^10.0.1",
    "proper-lockfile": "^4.1.2",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
