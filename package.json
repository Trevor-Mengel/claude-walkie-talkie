    "proper-lockfile": "^4.1.2",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
